{
  "name": "agentic-ci-review-lab",
  "version": "1.0.0",
  "description": "Experimental CI pipeline exploring agentic AI code review. Compares CodeRabbit with a custom policy agent to evaluate automated PR governance, architecture checks, and AI-assisted developer feedback in a production-like workflow.",
  "main": "dist/src/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "review:policy": "node scripts/review-policy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raiffhg/agentic-ci-review-lab.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/raiffhg/agentic-ci-review-lab/issues"
  },
  "homepage": "https://github.com/raiffhg/agentic-ci-review-lab#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
